# Copy to .env locally only. On Render enter values in Environment; never commit secrets.
TELEGRAM_TOKEN=
GROQ_API_KEYS=
# Direct PostgreSQL endpoint, not transaction pooler. TLS required for external DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
WEBHOOK_URL=https://YOUR-EXISTING-SERVICE.onrender.com/webhook
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
ADMIN_USER_IDS=
ALLOWED_USER_IDS=
# Optional search; empty disables external search honestly.
TAVILY_API_KEY=
PORT=10000
WORKERS=2
QUEUE_SIZE=200
# LOCAL safety budgets, NOT a statement of current provider free quotas.
DAILY_REQUEST_LIMIT=900
DAILY_TOKEN_LIMIT=180000
MINUTE_TOKEN_LIMIT=30000
USER_DAILY_LIMIT=50
MAX_OUTPUT_TOKENS=1200
CONTEXT_CHARS=12000
MPLCONFIGDIR=/tmp/matplotlib
